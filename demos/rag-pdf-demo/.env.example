# VelesDB RAG Demo Configuration

# Directory where the embedded VelesDB database persists collections.
# The demo runs VelesDB in-process — there is no server URL to configure.
# Delete this directory to reset the demo (see README "Complete Cleanup").
VELESDB_DATA_PATH=./rag-data

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Text chunking settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Collection name in VelesDB
COLLECTION_NAME=rag_documents
