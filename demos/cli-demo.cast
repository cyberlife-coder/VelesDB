[0.011, "o", "\u001b[1m\u001b[32mVelesDB CLI demo\u001b[2m — vector + graph + columnstore + hybrid fusion, one binary.\r\n"]
[0.005, "o", "\r\n\u001b[1m\u001b[36m── seed: 6 documents, fixed vectors (no network, no model) \u001b[2m(0s)\r\n"]
[0.000, "o", "\u001b[33m$\u001b[2m /tmp/wt-w2718/target/debug/velesdb collection create /var/folders/r_/bn7590md3y12rfvq69p4bz2c0000gn/T//velesdb-cli-demo docs -d 4 -m cosine\r\n"]
[0.018, "o", "\u001b[32m✅\u001b[0m Vector collection '\u001b[36mdocs\u001b[0m' created (4 dims, Cosine, Full)\r\n"]
[0.523, "o", "\u001b[2m6 documents upserted into 'docs' (deterministic vectors — distances below are stable).\u001b[2m\r\n\r\n"]
[0.000, "o", "\u001b[1m\u001b[36m── ANN search + metadata filter: near [1,0,0,0] AND category='tech' \u001b[2m(0s)\r\n"]
