[0.044, "o", "┌────┬────────────────────────┐\r\n│\u001b[38;5;14m id \u001b[39m┆\u001b[38;5;14m title                  \u001b[39m│\r\n╞════╪════════════════════════╡\r\n│ 2  ┆ Rust programming guide │\r\n├╌╌╌╌┼╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌┤\r\n│ 3  ┆ Rust cookbook          │\r\n├╌╌╌╌┼╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌┤\r\n│ 1  ┆ LSM-tree internals     │\r\n└────┴────────────────────────┘\r\n"]
[0.010, "o", "\u001b[2mDoc 2 sits mid-rank in each single branch yet tops the fused list — that is what RRF buys you.\u001b[2m\r\n"]
