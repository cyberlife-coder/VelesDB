[0.044, "o", "┌────┬────────────────────────┐\r\n│\u001b[38;5;14m id \u001b[39m┆\u001b[38;5;14m title                  \u001b[39m│\r\n╞════╪════════════════════════╡\r\n│ 3  ┆ Rust cookbook          │\r\n├╌╌╌╌┼╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌┤\r\n│ 2  ┆ Rust programming guide │\r\n└────┴────────────────────────┘\r\n"]
[0.010, "o", "\r\n\u001b[1m\u001b[36m── fused: NEAR + MATCH, USING FUSION rrf (k=60) \u001b[2m(1s)\r\n"]
